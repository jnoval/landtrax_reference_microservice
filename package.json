{
  "name": "reference-microservice",
  "version": "0.0.1",
  "description": "Reference & Catalog Microservice for LandTrax (service-catalog, requirement, system-settings, location, faq)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/app.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/app.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/app.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/app.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/app.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/config/app.config.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "escape-html": "^1.0.3",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.26",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1",
      "^src/(.*)\\.js$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!main.ts",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/axios)"
    ],
    "forceExit": true,
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/setup.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "main\\.ts$",
      "/shared/infrastructure/database/entities/",
      "/shared/infrastructure/database/models/",
      "/shared/contracts/",
      "/shared/common/",
      "/src/config/",
      "\\.dto\\.ts$",
      "\\.entity\\.ts$"
    ],
    "coverageProvider": "v8"
  }
}
